# Zwischenspeicher- und Sicherheitsregeln.
# Cloudflare Pages und Netlify lesen diese Datei aus dem veröffentlichten
# Verzeichnis. Andere Hoster ignorieren sie folgenlos.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Bilder und Schriften tragen die Größe im Dateinamen und ändern sich nie —
# sie dürfen dauerhaft zwischengespeichert werden.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Stylesheet und Skript ändern sich bei jeder Anpassung: kurz vorhalten,
# dann beim Server rückfragen.
/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Die Seiten selbst immer frisch holen.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
